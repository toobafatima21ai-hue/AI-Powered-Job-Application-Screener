# ============================================
# AI Job Screening Agent Configuration
# ============================================

# Groq API Key
# Get your API key from:
# https://console.groq.com/keys
#
# Replace this value with your actual key

GROQ_API_KEY=your_groq_api_key_here


# ============================================
# LLM Configuration
# ============================================

# Groq model used for candidate evaluation
# Examples:
# llama-3.3-70b-versatile
# llama-3.1-8b-instant
# mixtral-8x7b-32768

MODEL_NAME=llama-3.3-70b-versatile


# Controls randomness of model output
# 0 = more deterministic and consistent

TEMPERATURE=0.0


# ============================================
# Reliability Settings
# ============================================

# Maximum time allowed for one LLM request

LLM_TIMEOUT_SECONDS=30


# Number of retry attempts if:
# - JSON parsing fails
# - schema validation fails

MAX_RETRIES=2


# ============================================
# Business Rule Configuration
# ============================================

# Minimum total experience required

MIN_TOTAL_EXPERIENCE_YEARS=1


# Candidate rejected if Python experience
# is equal to or below this value

MIN_PYTHON_YEARS_FOR_DISQUALIFY=0